Style;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7_d_tgt" target="p7_show"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_e_restart" value="Restart app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7_select" target="p7_r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_e_exit" value="Exit kiosk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7_select" target="p7_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_e_close" value="Close" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7_select" target="p7_w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_note1" value="&lt;b&gt;Dashboard data&lt;/b&gt;&lt;br&gt;Reads vendo_log.txt (flat file, no DB). Test print sends A4 B&amp;W; simulation saves temp/output/sim_test_page.png. Clear temp deletes output/converted/uploads. Reset credit sets ₱0. Simulation toggle changes free-credit controls." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="460" height="90" as="geometry"/></mxCell><mxCell id="p7_note2" value="&lt;b&gt;Exit &amp; return&lt;/b&gt;&lt;br&gt;Other operations update the dashboard and return via D. Admin idle 300 s → Welcome (W). Close → Welcome; Exit quits; Restart reinitializes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="680" width="400" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>