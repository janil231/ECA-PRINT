<mxfile host="app.diagrams.net" modified="2026-11-15T00:00:00.000Z" agent="opencode" version="32.6.10" type="device"><diagram id="eca_flow_p1" name="1 Startup &amp; Customer Entry"><mxGraphModel dx="1169" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="ECA Print Kiosk — Logical Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="800" height="28" as="geometry"/></mxCell><mxCell id="p1_subtitle" value="Page 1 of 7 · Startup &amp; Customer Entry · Source: print-vendo code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="18" as="geometry"/></mxCell><mxCell id="p1_footer" value="ECA Print Kiosk Flowchart · Page 1 of 7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8E8E93;fontSize=9;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="340" height="16" as="geometry"/></mxCell><mxCell id="p1_start" value="START&lt;br&gt;Staff launches ECAPrint.exe" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1FADF;strokeColor=#248A3D;strokeWidth=2;fontColor=#111827;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="280" height="50" as="geometry"/></mxCell><mxCell id="p1_init" value="&lt;b&gt;INITIALIZE APPLICATION&lt;/b&gt;&lt;br&gt;Anchor working folder to the .exe · create temp/output and temp/uploads&lt;br&gt;Start app log (temp/app_log.txt when frozen) · ensure Windows hotspot&lt;br&gt;Delete previews older than 1 day and converted Word PDFs older than 7 days&lt;br&gt;Clear previous customer uploads/converted/output · seed demo files once&lt;br&gt;Generate sample PDF if missing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="560" height="120" as="geometry"/></mxCell><mxCell id="p1_services" value="&lt;b&gt;START KIOSK SERVICES&lt;/b&gt;&lt;br&gt;Light fullscreen UI scaled to screen · header · coin reader (real or simulation)&lt;br&gt;Flask upload server on 0.0.0.0:5000 · inactivity watchdog&lt;br&gt;Clear stale errored print jobs · poll printer health every 20 s&lt;br&gt;Show Welcome screen with kiosk IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="200" y="290" width="560" height="110" as="geometry"/></mxCell><mxCell id="p1_welcome" value="&lt;b&gt;OUTPUT — SHOW WELCOME&lt;/b&gt;&lt;br&gt;USB Drive · Phone / QR · hidden Staff access (5 title taps or Ctrl+Shift+A)&lt;br&gt;B&amp;W ₱2/page · Color ₱4/page · A4 / Long / Short · Coins" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="200" y="430" width="560" height="70" as="geometry"/></mxCell><mxCell id="p1_input" value="&lt;b&gt;INPUT — CUSTOMER INPUT&lt;/b&gt;&lt;br&gt;Choose USB Drive, Phone / QR, or Staff access" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="330" y="530" width="300" height="60" as="geometry"/></mxCell><mxCell id="p1_w" value="W&lt;br&gt;Return to Welcome" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="20" y="435" width="130" height="60" as="geometry"/></mxCell><mxCell id="p1_r" value="R&lt;br&gt;Restart app" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="130" height="60" as="geometry"/></mxCell><mxCell id="p1_1a" value="1A&lt;br&gt;To USB File Selection" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="180" height="55" as="geometry"/></mxCell><mxCell id="p1_1b" value="1B&lt;br&gt;To Phone Upload" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="390" y="680" width="180" height="55" as="geometry"/></mxCell><mxCell id="p1_1c" value="1C&lt;br&gt;To Admin &amp; Exit" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="650" y="680" width="170" height="55" as="geometry"/></mxCell><mxCell id="p1_e_start_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_start" target="p1_init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_init_services" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_init" target="p1_services"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_services_welcome" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_services" target="p1_welcome"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_welcome_input" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_welcome" target="p1_input"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_w" value="return / timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_w" target="p1_welcome"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_r" value="restart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_r" target="p1_init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_usb" value="USB Drive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_input" target="p1_1a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="560"/></Array></mxGeometry></mxCell><mxCell id="p1_e_phone" value="Phone / QR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_input" target="p1_1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_e_staff" value="Staff access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_input" target="p1_1c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="560"/></Array></mxGeometry></mxCell><mxCell id="p1_legend_title" value="LEGEND" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="140" width="300" height="18" as="geometry"/></mxCell><mxCell id="p1_l1s" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1FADF;strokeColor=#248A3D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="168" width="54" height="26" as="geometry"/></mxCell><mxCell id="p1_l1t" value="Start / End (ellipse)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="904" y="166" width="230" height="26" as="geometry"/></mxCell><mxCell id="p1_l2s" value="" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="840" y="202" width="54" height="26" as="geometry"/></mxCell><mxCell id="p1_l2t" value="Input / Output (parallelogram)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="904" y="200" width="230" height="26" as="geometry"/></mxCell><mxCell id="p1_l3s" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="840" y="236" width="54" height="26" as="geometry"/></mxCell><mxCell id="p1_l3t" value="Process / action (rectangle)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="904" y="234" width="230" height="26" as="geometry"/></mxCell><mxCell id="p1_l4s" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="54" height="40" as="geometry"/></mxCell><mxCell id="p1_l4t" value="Decision (diamond, T/F only)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="904" y="268" width="230" height="40" as="geometry"/></mxCell><mxCell id="p1_l5s" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#007AFF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="850" y="322" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_l5t" value="On-page connector (circle + ID)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="904" y="320" width="230" height="34" as="geometry"/></mxCell><mxCell id="p1_l6s" value="" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="840" y="366" width="54" height="34" as="geometry"/></mxCell><mxCell id="p1_l6t" value="Off-page connector (matching ID)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="904" y="364" width="230" height="34" as="geometry"/></mxCell><mxCell id="p1_legend_note" value="&lt;b&gt;No upward arrows.&lt;/b&gt; Loops jump with a circle or an off-page connector. Parallelograms are input or output; red = error output." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="408" width="300" height="55" as="geometry"/></mxCell><mxCell id="p1_nodb" value="&lt;b&gt;NO DATABASE CYLINDER&lt;/b&gt;&lt;br&gt;Sales are appended to vendo_log.txt, a flat file. Admin reads and summarizes that file. No DBMS is used." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="468" width="300" height="76" as="geometry"/></mxCell><mxCell id="p1_bg" value="&lt;b&gt;BACKGROUND RULES&lt;/b&gt;&lt;br&gt;Welcome is protected from idle reset. Credit expires after 300 s idle, but never during Payment/Printing. Header shows credit, payment, and printer warnings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="562" width="300" height="90" as="geometry"/></mxCell><mxCell id="p1_one" value="&lt;b&gt;ONE START / ONE END&lt;/b&gt;&lt;br&gt;The only Start is on this page; the only End is on Page 7. Restart uses connector R." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="670" width="300" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="eca_flow_p2" name="2 USB File Selection"><mxGraphModel dx="1169" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="ECA Print Kiosk — Logical Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="800" height="28" as="geometry"/></mxCell><mxCell id="p2_subtitle" value="Page 2 of 7 · USB File Selection · Source: print-vendo code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="18" as="geometry"/></mxCell><mxCell id="p2_footer" value="ECA Print Kiosk Flowchart · Page 2 of 7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8E8E93;fontSize=9;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="340" height="16" as="geometry"/></mxCell><mxCell id="p2_1a" value="1A&lt;br&gt;From Welcome — USB Drive" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="190" y="65" width="190" height="55" as="geometry"/></mxCell><mxCell id="p2_l" value="L&lt;br&gt;From QR / Settings / Payment" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="450" y="65" width="190" height="55" as="geometry"/></mxCell><mxCell id="p2_open" value="&lt;b&gt;OPEN 'YOUR FILES'&lt;/b&gt;&lt;br&gt;Scan removable drives recursively + temp/ (skip temp/converted and temp/output)&lt;br&gt;Collect supported files and sort them" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="190" y="150" width="480" height="80" as="geometry"/></mxCell><mxCell id="p2_details" value="&lt;b&gt;LOAD LIST DETAILS&lt;/b&gt;&lt;br&gt;Show name and type; count pages in background (fast count for DOC/DOCX)&lt;br&gt;Supported: PDF, DOC, DOCX, JPG, PNG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="190" y="260" width="480" height="70" as="geometry"/></mxCell><mxCell id="p2_found" value="Supported&lt;br&gt;files found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="260" height="110" as="geometry"/></mxCell><mxCell id="p2_rows" value="&lt;b&gt;OUTPUT — SHOW FILE LIST&lt;/b&gt;&lt;br&gt;Display file rows with names, types, and page counts" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="240" y="500" width="380" height="55" as="geometry"/></mxCell><mxCell id="p2_select" value="&lt;b&gt;INPUT — CUSTOMER SELECTS A FILE&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="240" y="575" width="380" height="50" as="geometry"/></mxCell><mxCell id="p2_selected" value="&lt;b&gt;PASS SELECTED FILE&lt;/b&gt;&lt;br&gt;Send the file path to Print Settings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="240" y="645" width="380" height="50" as="geometry"/></mxCell><mxCell id="p2_2a" value="2A&lt;br&gt;To Print Settings" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="330" y="720" width="200" height="50" as="geometry"/></mxCell><mxCell id="p2_empty" value="&lt;b&gt;OUTPUT — NO FILES FOUND&lt;/b&gt;&lt;br&gt;Plug in a USB drive or upload from a phone" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDE7E6;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#111827;fontSize=10.5;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="370" width="330" height="90" as="geometry"/></mxCell><mxCell id="p2_back" value="&lt;b&gt;INPUT — CUSTOMER TAPS BACK&lt;/b&gt;&lt;br&gt;Re-enter USB after plugging in; the list is a snapshot and does not auto-refresh" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="500" width="330" height="70" as="geometry"/></mxCell><mxCell id="p2_w" value="W&lt;br&gt;To Welcome" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="720" y="610" width="180" height="55" as="geometry"/></mxCell><mxCell id="p2_e_1a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_1a" target="p2_open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_e_l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_l" target="p2_open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_e_open_details" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_open" target="p2_details"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_e_details_found" value="" st