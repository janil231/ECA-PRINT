Color=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_accepted" target="p3_saved"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_e_accepted_err" value="F" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_accepted" target="p3_phone_err"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="400"/></Array></mxGeometry></mxCell><mxCell id="p3_e_err_u" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_phone_err" target="p3_u_src"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_e_saved_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_saved" target="p3_saved_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_e_u_tgt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_u_tgt" target="p3_phone_pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_note1" value="&lt;b&gt;Upload rules&lt;/b&gt;&lt;br&gt;PDF, DOC, DOCX, JPG, PNG · max 50 MB · filename sanitized · saved in temp/uploads. Flask serves the phone page on port 5000." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="480" height="90" as="geometry"/></mxCell><mxCell id="p3_note2" value="&lt;b&gt;QR screen&lt;/b&gt;&lt;br&gt;Idle 300 s → Welcome (W). The phone-side steps at right run independently after the QR is scanned. Uploads never auto-open on the kiosk; the customer taps Continue to files. Back returns to Welcome." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="440" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="eca_flow_p4" name="4 Print Settings &amp; Preview"><mxGraphModel dx="1169" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_title" value="ECA Print Kiosk — Logical Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="800" height="28" as="geometry"/></mxCell><mxCell id="p4_subtitle" value="Page 4 of 7 · Print Settings &amp; Preview · Source: print-vendo code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="18" as="geometry"/></mxCell><mxCell id="p4_footer" value="ECA Print Kiosk Flowchart · Page 4 of 7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8E8E93;fontSize=9;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="340" height="16" as="geometry"/></mxCell><mxCell id="p4_2a" value="2A&lt;br&gt;From File List — selected file" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="100" y="65" width="220" height="55" as="geometry"/></mxCell><mxCell id="p4_open" value="&lt;b&gt;OPEN PRINT SETTINGS&lt;/b&gt;&lt;br&gt;Read total pages · for DOC/DOCX start Word conversion (60 s timeout)&lt;br&gt;Render page 1 preview · show file name and page count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="560" height="90" as="geometry"/></mxCell><mxCell id="p4_ready" value="Document&lt;br&gt;ready?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="230" y="260" width="260" height="100" as="geometry"/></mxCell><mxCell id="p4_unavailable" value="&lt;b&gt;OUTPUT — DOCUMENT UNAVAILABLE&lt;/b&gt;&lt;br&gt;Preview unavailable; Continue disabled · customer can go Back" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDE7E6;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#111827;fontSize=10.5;spacing=5;" vertex="1" parent="1"><mxGeometry x="680" y="270" width="360" height="80" as="geometry"/></mxCell><mxCell id="p4_l_err" value="L&lt;br&gt;To File List" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="160" height="55" as="geometry"/></mxCell><mxCell id="p4_settings" value="&lt;b&gt;OUTPUT — SHOW SETTINGS + PREVIEW&lt;/b&gt;&lt;br&gt;B&amp;W ₱2/pg or Color ₱4/pg · copies 1–10 · A4 / Long / Short&lt;br&gt;Prev/Next preview · preview reflects mode and paper&lt;br&gt;Back returns to file list (L)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="150" y="390" width="460" height="80" as="geometry"/></mxCell><mxCell id="p4_total" value="&lt;b&gt;COMPUTE TOTAL&lt;/b&gt;&lt;br&gt;Total = total pages × copies × rate&lt;br&gt;All pages are printed (no page-range selector)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="150" y="490" width="460" height="60" as="geometry"/></mxCell><mxCell id="p4_continue" value="&lt;b&gt;INPUT — CUSTOMER TAPS CONTINUE&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="150" y="570" width="460" height="50" as="geometry"/></mxCell><mxCell id="p4_printer" value="Printer&lt;br&gt;ready?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="250" y="640" width="260" height="90" as="geometry"/></mxCell><mxCell id="p4_warn" value="&lt;b&gt;OUTPUT — PRINTER WARNING&lt;/b&gt;&lt;br&gt;Continue disabled · recheck on entry, every 5 s, and on Continue" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDE7E6;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#111827;fontSize=10.5;spacing=5;" vertex="1" parent="1"><mxGeometry x="600" y="640" width="420" height="90" as="geometry"/></mxCell><mxCell id="p4_4a" value="4A&lt;br&gt;To Checkout" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="260" y="750" width="180" height="45" as="geometry"/></mxCell><mxCell id="p4_e_2a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_2a" target="p4_open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_open_ready" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_open" target="p4_ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_ready_settings" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_ready" target="p4_settings"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_ready_unavailable" value="F" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_ready" target="p4_unavailable"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_unavailable_l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_unavailable" target="p4_l_err"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_settings_total" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_settings" target="p4_total"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_total_continue" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_total" target="p4_continue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_continue_printer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_continue" target="p4_printer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_printer_4a" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_printer" target="p4_4a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_e_printer_warn" value="F" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_printer" target="p4_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4_note1" value="&lt;b&gt;Pricing&lt;/b&gt;&lt;br&gt;B&amp;W ₱2/page; Color ₱4/page; copies 1–10; A4 / Long / Short. DOC/DOCX need Microsoft Word; 60 s timeout. If conversion fails, Continue stays disabled." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="360" height="90" as="geometry"/></mxCell><mxCell id="p4_note2" value="&lt;b&gt;Printer block reasons&lt;/b&gt;&lt;br&gt;No printer, offline, paper out, jam, or printer error. Continue is blocked until the printer is ready." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="360" height="80" as="geometry"/></mxCell><mxCell id="p4_note3" value="&lt;b&gt;Timer&lt;/b&gt;&lt;br&gt;Idle 60 s on this screen → Welcome (see Page 1). Payment and Printing are protected from idle reset." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="735" width="460" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="eca_flow_p5" name="5 Checkout &amp; Payment"><mxGraphModel dx="1169" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_title" value="ECA Print Kiosk — Logical Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="800" height="28" as="geometry"/></mxCell><mxCell id="p5_subtitle" value="Page 5 of 7 · Checkout &amp; Payment · Source: print-vendo code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="18" as="geometry"/></mxCell><mxCell id="p5_footer" value="ECA Print Kiosk Flowchart · Page 5 of 7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8E8E93;fontSize=9;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="340" height="16" as="geometry"/></mxCell><mxCell id="p5_4a" value="4A&lt;br&gt;From Settings — job + total due" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="220" height="55" as="geometry"/></mxCell><mxCell id="p5_checkout" value="&lt;b&gt;OUTPUT — SHOW CHECKOUT&lt;/b&gt;&lt;br&gt;File, mode, pages, copies, total due, current coin credit" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="220" y="130" width="460" height="60" as="geometry"/></mxCell><mxCell id="p5_remaining" value="&lt;b&gt;COMPUTE REMAINING&lt;/b&gt;&lt;br&gt;remaining = max(0, due − credit) · show 'Insert ₱X more'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="220" y="220" width="460" height="50" as="geometry"/></mxCell><mxCell id="p5_paid" value="Credit ≥&lt;br&gt;due?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="240" height="90" as="geometry"/></mxCell><mxCell id="p5_accept" value="&lt;b&gt;ACCEPT PAYMENT&lt;/b&gt;&lt;br&gt;Coin pulses (CH-926: 1 pulse = ₱1) or simulation +₱1/+₱5/+₱10/C&lt;br&gt;If coin slot is offline, show warning · no change is given" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="660" y="305" width="420" height="80" as="geometry"/></mxCell><mxCell id="p5_updated" value="Credit updated; remaining recalculated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="660" y="415" width="420" height="60" as="geometry"/></mxCell><mxCell id="p5_c_src" value="C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#007AFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="505" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5_c_tgt" value="C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#007AFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="325" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5_confirm" value="&lt;b&gt;OUTPUT — SHOW CONFIRM &amp; START PRINTING&lt;/b&gt;&lt;br&gt;Simulation coin buttons are hidden when fully paid" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="260" y="410" width="380" height="55" as="geometry"/></mxCell><mxCell id="p5_confirm_click" value="&lt;b&gt;INPUT — CUSTOMER TAPS CONFIRM&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="260" y="485" width="380" height="50" as="geometry"/></mxCell><mxCell id="p5_recheck" value="&lt;b&gt;RECHECK PRINTER&lt;/b&gt;&lt;br&gt;Hand job to Printing; no credit is deducted yet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="260" y="555" width="380" height="50" as="geometry"/></mxCell><mxCell id="p5_printer" value="Printer&lt;br&gt;ready?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="320" y="625" width="260" height="90" as="geometry"/></mxCell><mxCell id="p5_5a" value="5A&lt;br&gt;To Printing" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="360" y="735" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5_warn" value="&lt;b&gt;OUTPUT — PRINTER WARNING&lt;/b&gt;&lt;br&gt;Stay on Checkout; no charge; tap Confirm again to recheck" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDE7E6;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#111827;fontSize=10.5;spacing=5;" vertex="1" parent="1"><mxGeometry x="660" y="630" width="420" height="80" as="geometry"/></mxCell><mxCell id="p5_cancel" value="&lt;b&gt;INPUT — CANCEL / BACK&lt;/b&gt;&lt;br&gt;Keep credit" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="130" y="600" width="180" height="60" as="geometry"/></mxCell><mxCell id="p5_l" value="L&lt;br&gt;To File List" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="140" y="700" width="160" height="50" as="geometry"/></mxCell><mxCell id="p5_e_4a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_4a" target="p5_checkout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_checkout_remaining" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_checkout" target="p5_remaining"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_remaining_paid" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_remaining" target="p5_paid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_paid_accept" value="F" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_paid" target="p5_accept"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_accept_updated" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_accept" target="p5_updated"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_updated_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_updated" target="p5_c_src"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_c_tgt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_c_tgt" target="p5_paid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_paid_confirm" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_paid" target="p5_confirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_confirm_click" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_confirm" target="p5_confirm_click"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_click_recheck" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_confirm_click" target="p5_recheck"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_recheck_printer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_recheck" target="p5_printer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_printer_5a" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_printer" target="p5_5a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_printer_warn" value="F" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_printer" target="p5_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_cancel" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_remaining" target="p5_cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_e_cancel_l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#374151;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_cancel" target="p5_l"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5_note1" value="&lt;b&gt;Payment rules&lt;/b&gt;&lt;br&gt;Real mode: only coin pulses add credit. Simulation +₱ buttons and the C key are disabled. No change is given; leftover credit stays." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="160" height="120" as="geometry"/></mxCell><mxCell id="p5_note2" value="&lt;b&gt;Protection&lt;/b&gt;&lt;br&gt;Payment and Printing are protected from idle reset; credit is not cleared mid-transaction. Credit is deducted only after a successful print." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="725" width="420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="eca_flow_p6" name="6 Printing &amp; Result"><mxGraphModel dx="1169" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6_title" value="ECA Print Kiosk — Logical Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="800" height="28" as="geometry"/></mxCell><mxCell id="p6_subtitle" value="Page 6 of 7 · Printing &amp; Result · Source: print-vendo code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="18" as="geometry"/></mxCell><mxCell id="p6_footer" value="ECA Print Kiosk Flowchart · Page 6 of 7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8E8E93;fontSize=9;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="340" height="16" as="geometry"/></mxCell><mxCell id="p6_5a" value="5A&lt;br&gt;From Checkout — confirmed job" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="100" y="55" width="220" height="55" as="geometry"/></mxCell><mxCell id="p6_start" value="&lt;b&gt;START PRINTING SCREEN&lt;/b&gt;&lt;br&gt;Background thread · recheck printer · screen is protected from idle reset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="560" height="60" as="geometry"/></mxCell><mxCell id="p6_blocked" value="Printer&lt;br&gt;blocked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="230" y="210" width="260" height="90" as="geometry"/></mxCell><mxCell id="p6_blocked_err" value="&lt;b&gt;OUTPUT — PRINTER BLOCKED&lt;/b&gt;&lt;br&gt;Show 'Out of paper / jam / offline — ask staff'&lt;br&gt;Do not charge; keep credit" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDE7E6;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#111827;fontSize=10.5;spacing=5;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="460" height="90" as="geometry"/></mxCell><mxCell id="p6_blocked_wait" value="Wait 7 s; return to Welcome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="460" height="50" as="geometry"/></mxCell><mxCell id="p6_w1" value="W&lt;br&gt;To Welcome" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="720" y="410" width="160" height="50" as="geometry"/></mxCell><mxCell id="p6_render" value="&lt;b&gt;RENDER + PREPARE&lt;/b&gt;&lt;br&gt;Selected pages only · B&amp;W or Color · copies · 300 DPI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="460" height="60" as="geometry"/></mxCell><mxCell id="p6_print" value="&lt;b&gt;PRINT EACH PAGE / COPY&lt;/b&gt;&lt;br&gt;Real Epson L120 via Windows spooler · simulation saves PNGs to temp/output&lt;br&gt;Progress bar and paper animation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="150" y="420" width="460" height="80" as="geometry"/></mxCell><mxCell id="p6_drained" value="All pages printed /&lt;br&gt;queue drained?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="230" y="530" width="260" height="90" as="geometry"/></mxCell><mxCell id="p6_success" value="&lt;b&gt;FINALIZE SALE&lt;/b&gt;&lt;br&gt;Deduct credit · append vendo_log.txt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="150" y="635" width="460" height="45" as="geometry"/></mxCell><mxCell id="p6_receipt" value="&lt;b&gt;OUTPUT — SHOW DONE + RECEIPT&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWid