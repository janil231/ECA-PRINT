gt;Timer&lt;/b&gt;&lt;br&gt;Idle 60 s on this screen → Welcome (W). Back also returns to Welcome." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E8E93;strokeWidth=1;dashed=1;fontColor=#374151;fontSize=9.5;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="690" width="360" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="eca_flow_p3" name="3 Phone Upload"><mxGraphModel dx="1169" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_title" value="ECA Print Kiosk — Logical Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#111827;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="800" height="28" as="geometry"/></mxCell><mxCell id="p3_subtitle" value="Page 3 of 7 · Phone Upload · Source: print-vendo code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="900" height="18" as="geometry"/></mxCell><mxCell id="p3_footer" value="ECA Print Kiosk Flowchart · Page 3 of 7" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#8E8E93;fontSize=9;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="340" height="16" as="geometry"/></mxCell><mxCell id="p3_1b" value="1B&lt;br&gt;From Welcome — Phone / QR" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="100" y="65" width="200" height="55" as="geometry"/></mxCell><mxCell id="p3_qr" value="&lt;b&gt;OUTPUT — SHOW PHONE / QR UPLOAD SCREEN&lt;/b&gt;&lt;br&gt;Join Wi-Fi 'ECA Print' (password ecaprint123)&lt;br&gt;Scan QR → http://[kiosk-ip]:5000&lt;br&gt;Choose file, upload, then tap Continue to files" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="480" height="100" as="geometry"/></mxCell><mxCell id="p3_wait" value="&lt;b&gt;WAIT FOR UPLOAD / CUSTOMER ACTION&lt;/b&gt;&lt;br&gt;Kiosk does not auto-advance when the phone upload finishes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="480" height="70" as="geometry"/></mxCell><mxCell id="p3_continue" value="Continue to&lt;br&gt;files?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="190" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="p3_l" value="L&lt;br&gt;To File List" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="235" y="550" width="170" height="55" as="geometry"/></mxCell><mxCell id="p3_w" value="W&lt;br&gt;To Welcome" style="shape=offPageConnector;whiteSpace=wrap;html=1;size=0.22;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=10;fontStyle=1;spacing=3;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="170" height="55" as="geometry"/></mxCell><mxCell id="p3_phone_open" value="&lt;b&gt;INPUT — PHONE JOINS HOTSPOT &amp; OPENS PAGE&lt;/b&gt;&lt;br&gt;Scan the kiosk QR or type http://[kiosk-ip]:5000&lt;br&gt;No app to install" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="440" height="80" as="geometry"/></mxCell><mxCell id="p3_phone_pick" value="&lt;b&gt;INPUT — PHONE CHOOSES FILE &amp; TAPS UPLOAD&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="440" height="60" as="geometry"/></mxCell><mxCell id="p3_accepted" value="Upload&lt;br&gt;accepted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="220" height="100" as="geometry"/></mxCell><mxCell id="p3_saved" value="&lt;b&gt;SAVE FILE&lt;/b&gt;&lt;br&gt;Save to temp/uploads; it appears in the kiosk file list after Continue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#007AFF;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="480" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3_saved_out" value="&lt;b&gt;OUTPUT — PHONE SUCCESS&lt;/b&gt;&lt;br&gt;Phone shows upload success" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F2F2F7;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="560" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3_phone_err" value="&lt;b&gt;OUTPUT — ERROR&lt;/b&gt;&lt;br&gt;Phone error; retry" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDE7E6;strokeColor=#FF3B30;strokeWidth=1.5;fontColor=#111827;